PORT=4000
MONGO_URI=mongodb://localhost:27017/three-way-match
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123

# Gemini
GEMINI_API_KEY=
# If this model 404s or 429s with your key, list what's actually available:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# and pick one that supports generateContent - model availability/quota
# varies by account and changes over time.
GEMINI_MODEL=gemini-2.0-flash
# When true (or when GEMINI_API_KEY is unset), the parsing pipeline uses
# deterministic fixture responses instead of calling the real Gemini API.
MOCK_GEMINI=true

UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:3000
